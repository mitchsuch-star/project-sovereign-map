# Claude Code local settings
.claude/settings.local.json

# Local media parked OUTSIDE res:// so Godot never scans/exports it
# (Aug 2026 shippable-build P0: a stray 265MB movies.avi lived in assets/)
local_archive/

# Local agent state and scratch outputs
.claude/
.pytest_tmp*/
audit_tmp_check/
pytest_tmp_runtime/
.ruff_cache/

# Root-level local response dumps and screenshots
/*_out.json
/dis.json
/d?.json
/ledger*.json
/opt*.json
/rej*.json
/tt*.json
/vl*.json
/game_window.png
/terminal.png
