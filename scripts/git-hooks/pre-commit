#!/bin/sh
# Pre-commit quality gate for project-sovereign-map (per CLAUDE.md).
# Enforces the project's quality bar before every commit:
#   1. ruff lint on backend/
#   2. the FULL pytest suite (tests/), in PARALLEL
# Any failure aborts the commit. Do NOT bypass with --no-verify; fix the
# underlying failure instead (CLAUDE.md "work directly on master" workflow).
#
# Pre-Deploy S2 step 0 (October 9, 2026, the user's "it takes sooo long"):
# the serial run had grown to ~26 minutes on 16 cores while this banner
# still promised four. The gate stays whole — every test still runs before
# anything reaches master — and runs under pytest-xdist, `--dist loadgroup`
# so each test module stays together on one worker.
#
# November 10, 2026 (the user's "the hook takes so long", then "Yes, split
# it"): the suite had grown to 38,900 tests and this hook to 10:48, and the
# timed run read why — every module that launches the Godot binary shared
# ONE group, so one worker was busy for ten of those minutes while seven sat
# idle. The lane is three now (`tests/conftest.py`, ENGINE_LANES: one window
# at a time, the headless harnesses beside it), the heaviest groups are
# handed out first (HEAVIEST_FIRST), and the workers are 10. The measured
# time is in the banner below; re-measure it when it drifts.

# PR-3 (playtest re-score, September 12 2026): these were the bare Windows
# literals, so on any non-Windows checkout the hook aborted every commit with
# "venv python not found" and the quality gate could not run at all. The
# Windows layout is probed FIRST, so on the machine the hook was written for
# the resolved values are byte-identical to the old literals.
if [ -f ".venv/Scripts/python.exe" ]; then
  PYTHON=".venv/Scripts/python.exe"
  RUFF=".venv/Scripts/ruff.exe"
elif [ -f ".venv/bin/python" ]; then
  PYTHON=".venv/bin/python"
  RUFF=".venv/bin/ruff"
else
  PYTHON=""
fi

if [ -z "$PYTHON" ]; then
  echo "[pre-commit] venv python not found (.venv/Scripts/python.exe or .venv/bin/python)" 1>&2
  echo "[pre-commit] create/restore the project venv, then retry." 1>&2
  exit 1
fi

echo "[pre-commit] ruff check backend/ ..."
if [ -f "$RUFF" ]; then
  "$RUFF" check backend/ || { echo "[pre-commit] ruff failed -- commit aborted." 1>&2; exit 1; }
else
  "$PYTHON" -m ruff check backend/ || { echo "[pre-commit] ruff failed -- commit aborted." 1>&2; exit 1; }
fi

# The parallel run needs pytest-xdist (requirements.txt). Without it the
# gate falls back to the serial run rather than skipping anything.
if "$PYTHON" -c "import xdist" 2>/dev/null; then
  echo "[pre-commit] full pytest suite (tests/), 10 workers -- measured 8:49 on this machine (November 10, 2026) ..."
  "$PYTHON" -m pytest tests/ -q -n 10 --dist loadgroup \
    || { echo "[pre-commit] tests failed -- commit aborted." 1>&2; exit 1; }
else
  echo "[pre-commit] pytest-xdist is not installed (pip install -r requirements.txt); running the suite serially (~30 minutes) ..."
  "$PYTHON" -m pytest tests/ -q || { echo "[pre-commit] tests failed -- commit aborted." 1>&2; exit 1; }
fi

echo "[pre-commit] OK -- ruff clean, suite green."
exit 0
