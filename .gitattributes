# Keep the tracked git hook script LF-only. It is copied verbatim into
# .git/hooks/ (see CLAUDE.md "work directly on master"); a CRLF shebang
# breaks the /bin/sh interpreter on checkout when core.autocrlf=true.
scripts/git-hooks/pre-commit text eol=lf

# The parked release-build patch (Sept 23, 2026) must round-trip byte-exact:
# autocrlf would give it CRLF on checkout and `git apply` would then refuse it.
deploy/parked/*.patch -text
