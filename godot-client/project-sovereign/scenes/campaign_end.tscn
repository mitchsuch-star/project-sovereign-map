[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/campaign_end.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/gilt_frame.gd" id="9_gilt"]

[sub_resource type="StyleBox" id="GiltFrame_panel"]
script = ExtResource("9_gilt")
bg_color = Color(0.102, 0.102, 0.18, 1)
border_color = Color(0.851, 0.753, 0.549, 1)
content_margin_left = 30.0
content_margin_top = 26.0
content_margin_right = 30.0
content_margin_bottom = 24.0

; GE-2 "the client" (ENDGAME_PLAN §4): the end screen — ONE scene, four
; registers (the Fall / the Humbled Peace / the Verdict of History / the
; Imperial Peace), fed by ONE backend payload (`game_end.screen_payload`).
; CanvasLayer 122 — above the diorama (121) and the pause menu (120): an
; ending is the last thing the campaign says, and nothing stacks over it.
[node name="CampaignEnd" type="CanvasLayer"]
layer = 122
visible = false
script = ExtResource("1_script")

[node name="BackgroundOverlay" type="ColorRect" parent="."]
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0.86)

; Authored as a centre-anchored 880x620 rect so `Utils.clamp_centered_panel`
; can shrink it to the live logical viewport (Interface Scale 2.0 halves it —
; the IQ-10 rule: a card fits by clamping, never by running off the screen).
[node name="PanelContainer" type="PanelContainer" parent="."]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -440.0
offset_top = -310.0
offset_right = 440.0
offset_bottom = 310.0
grow_horizontal = 2
grow_vertical = 2
theme_override_styles/panel = SubResource("GiltFrame_panel")

[node name="VBoxContainer" type="VBoxContainer" parent="PanelContainer"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="PanelContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"DisplayTitleLarge"
text = "THE VERDICT OF HISTORY"
horizontal_alignment = 1

[node name="DateLabel" type="Label" parent="PanelContainer/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.5, 0.5, 0.5, 1)
theme_type_variation = &"Caption"
text = ""
horizontal_alignment = 1

[node name="CauseLabel" type="Label" parent="PanelContainer/VBoxContainer"]
layout_mode = 2
theme_type_variation = &"Lead"
text = ""
horizontal_alignment = 1
autowrap_mode = 3

[node name="HSeparator" type="HSeparator" parent="PanelContainer/VBoxContainer"]
layout_mode = 2

; The body — the exile epilogue, THE RECORD, THE VERDICT — is variable
; length, so it scrolls; the title block above and the button row below stay
; pinned whatever the epilogue runs to (the Proclamation's shape).
[node name="ContentScroll" type="ScrollContainer" parent="PanelContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 200)
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="ContentLabel" type="RichTextLabel" parent="PanelContainer/VBoxContainer/ContentScroll"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 3
bbcode_enabled = true
text = ""
scroll_active = false
fit_content = true

[node name="HSeparator2" type="HSeparator" parent="PanelContainer/VBoxContainer"]
layout_mode = 2

[node name="ButtonContainer" type="HBoxContainer" parent="PanelContainer/VBoxContainer"]
layout_mode = 2
theme_override_constants/separation = 18
alignment = 1

[node name="PrimaryButton" type="Button" parent="PanelContainer/VBoxContainer/ButtonContainer"]
custom_minimum_size = Vector2(250, 46)
layout_mode = 2
text = "Continue"

[node name="SecondaryButton" type="Button" parent="PanelContainer/VBoxContainer/ButtonContainer"]
custom_minimum_size = Vector2(250, 46)
layout_mode = 2
text = "Main Menu"
