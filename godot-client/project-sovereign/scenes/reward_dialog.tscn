[node name="HSeparator" type="HSeparator" parent="PanelContainer/VBoxContainer"]
layout_mode = 2

; July 18, 2026 viewport sweep: the ES-7 explainer was fit_content=true /
; scroll_active=false outside any ScrollContainer, so a marshal with BOTH a
; shortfall clause and an active rente rendered enough text to push the
; "Not now" button off the bottom. The 150 is now a real budget with its own
; scrollbar (same shape as the wizard's AssessmentPanel).
[node name="InfoLabel" type="RichTextLabel" parent="PanelContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 150)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
fit_content = false
scroll_active = true

; Lowered 200 -> 120: it already carries SIZE_EXPAND_FILL, so it re-expands
; whenever the viewport allows. The only effect is that the panel's fixed
; minimum drops far enough for the clamp to actually bite on a halved logical
; viewport — without this the clamp is cosmetic.
[node name="ScrollContainer" type="ScrollContainer" parent="PanelContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 120)
layout_mode = 2
size_flags_vertical = 3

[node name="OptionsContainer" type="VBoxContainer" parent="PanelContainer/VBoxContainer/ScrollContainer"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 8

[node name="HSeparator2" type="HSeparator" parent="PanelContainer/VBoxContainer"]
layout_mode = 2

[node name="CancelButton" type="Button" parent="PanelContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_override_colors/font_color = Color(0.75, 0.72, 0.65, 1)
theme_override_colors/font_hover_color = Color(0.9, 0.9, 0.9, 1)
text = "Not now"
