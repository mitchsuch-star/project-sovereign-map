[node name="VBoxContainer" type="VBoxContainer" parent="PanelContainer"]
layout_mode = 2
theme_override_constants/separation = 8

; Needs a real floor of its own. It was the only zero-minimum expanding sibling,
; so once the relax pass distributed the shortfall across the regions that DO
; declare minimums, those exactly filled the budget and the preamble laid out at
; height ZERO — the treasury / narration / advisory block rendering as an
; invisible strip with no scrollbar and no truncation hint. A floor puts it in
; the flexible set, where the pass's 48px floor protects it like every sibling.
; Session UI-3 (November 12, 2026): on the settlement table (dtype
; settlement_confirm) this label is the table's HEAD — fit_content, never
; scrolling, no floor (`show_dialogue` sets it); every other dtype keeps this.
[node name="ContentLabel" type="RichTextLabel" parent="PanelContainer/VBoxContainer"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = true
text = ""
scroll_active = true
fit_content = false

; Session UI-3 (November 12, 2026): the settlement table's BODY is ONE scroll,
; not four stacked scroll areas (the blind readers' 5/10). A single
; ScrollContainer holds a VBox of the first-open line, one card per court (its
; words, then its Demand / Ease / Drop buttons), the coverage row and
; Talleyrand's footer — all built in code (`_render_per_court_table`). A VBox
; frames it: the scroll, then the whole-line pad `Utils.keep_whole_lines` adds
; beside it, then the "more below" strip (shown only while lines remain below,
; so it stands under the last line, never on it); the frame carries the table's
; height floor (re-derived per open) and the `relax_last` tag.
[node name="PerCourtFrame" type="VBoxContainer" parent="PanelContainer/VBoxContainer"]
visible = false
custom_minimum_size = Vector2(0, 320)
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 0

[node name="PerCourtScroll" type="ScrollContainer" parent="PanelContainer/VBoxContainer/PerCourtFrame"]
layout_mode = 2
size_flags_vertical = 3
horizontal_scroll_mode = 0

[node name="PerCourtBody" type="VBoxContainer" parent="PanelContainer/VBoxContainer/PerCourtFrame/PerCourtScroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 10

[node name="HSeparator" type="HSeparator" parent="PanelContainer/VBoxContainer"]
