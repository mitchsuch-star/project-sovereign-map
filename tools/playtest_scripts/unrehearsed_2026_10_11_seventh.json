{"line": "Levy troops in Picardy and Artois.", "intended": {"action": "recruit", "marshal": "state", "target": "Picardy", "note": "two provinces; first"}},
{"line": "The Emperor commands a levy in Guyenne.", "intended": {"action": "recruit", "marshal": "state", "target": "Guyenne", "note": "formal levy"}},
{"line": "Recruit cavalry in Gascony, they breed good horses there.", "intended": {"action": "recruit", "marshal": "state", "target": "Gascony", "note": "cavalry with reason"}},
{"line": "recruit infantry franche-comte", "intended": {"action": "recruit", "marshal": "state", "target": "Franche-Comte", "note": "no preposition"}},
{"line": "More men at Lyonnais — infantry, as many as the treasury allows.", "intended": {"action": "recruit", "marshal": "state", "target": "Lyonnais", "note": "recruit, open quantity"}},
{"line": "Raise infantry in Provence to guard the coast.", "intended": {"action": "recruit", "marshal": "state", "target": "Provence", "note": "recruit with reason"}},
{"line": "Berthier, recruit a brigade of infantry in Orleanais and send it to Lannes.", "intended": {"action": "recruit", "marshal": "Lannes", "target": "Orleanais", "note": "recruit with destination marshal"}},
{"line": "Enlist cavalry at Paris.", "intended": {"action": "recruit", "marshal": "state", "target": "Paris", "note": "enlist = recruit"}},
{"line": "recruitment in Brittany - infantry", "intended": {"action": "recruit", "marshal": "state", "target": "Brittany", "note": "noun form"}},
{"line": "I want a levy in Languedoc, infantry.", "intended": {"action": "recruit", "marshal": "state", "target": "Languedoc", "note": "levy as wish"}},
{"line": "Call up men in Flanders.", "intended": {"action": "recruit", "marshal": "state", "target": "Flanders", "note": "call up = recruit"}},
{"line": "Scout Swabia.", "intended": {"action": "scout", "marshal": "", "target": "Swabia", "note": "scout, no marshal named"}},
{"line": "Murat, scout Tyrol.", "intended": {"action": "scout", "marshal": "Murat", "target": "Tyrol", "note": "cavalry scout"}},
{"line": "send a patrol into bohemia — Bernadotte", "intended": {"action": "scout", "marshal": "Bernadotte", "target": "Bohemia", "note": "patrol = scout, name last"}},
{"line": "Lannes, send riders into Munich and report what Bavaria is doing.", "intended": {"action": "scout", "marshal": "Lannes", "target": "Munich", "note": "riders = scout"}},
{"line": "Reconnoitre Swabia with Murat's light horse.", "intended": {"action": "scout", "marshal": "Murat", "target": "Swabia", "note": "period verb"}},
{"line": "scout frankfurt", "intended": {"action": "scout", "marshal": "", "target": "Frankfurt", "note": "terse scout"}},
{"line": "Davout, find out what is in Nassau.", "intended": {"action": "scout", "marshal": "Davout", "target": "Nassau", "note": "find out = scout"}},
{"line": "Have Massena scout the Tyrol passes before he commits.", "intended": {"action": "scout", "marshal": "Massena", "target": "Tyrol", "note": "scout with precaution"}},
{"line": "Ney: reconnaissance toward Swabia, do not engage.", "intended": {"action": "scout", "marshal": "Ney", "target": "Swabia", "note": "scout with explicit no-attack"}},
{"line": "Berthier, I want eyes on Dresden — Bernadotte to scout it.", "intended": {"action": "scout", "marshal": "Bernadotte", "target": "Dresden", "note": "dictated scout"}},
{"line": "Scout Bern, Murat.", "intended": {"action": "scout", "marshal": "Murat", "target": "Bern", "note": "name last"}},
{"line": "recon swabia pls", "intended": {"action": "scout", "marshal": "", "target": "Swabia", "note": "slang scout"}},
{"line": "Soult will push patrols toward Swabia to fix Mack's position.", "intended": {"action": "scout", "marshal": "Soult", "target": "Swabia", "note": "patrols = scout"}},
{"line": "Scout Brabant — Davout.", "intended": {"action": "scout", "marshal": "Davout", "target": "Brabant", "note": "name last"}},
{"line": "Massena, probe Piedmont for any Austrian movement.", "intended": {"action": "scout", "marshal": "Massena", "target": "Piedmont", "note": "probe = scout"}},
{"line": "Soult, hold Lorraine.", "intended": {"action": "hold", "marshal": "Soult", "target": "Lorraine", "note": "hold in place"}},
{"line": "Davout hold position.", "intended": {"action": "hold", "marshal": "Davout", "target": "Rhineland", "note": "hold where he stands"}},
{"line": "Bernadotte, stay where you are at Franconia until I say otherwise.", "intended": {"action": "hold", "marshal": "Bernadotte", "target": "Franconia", "note": "stay = hold"}},
{"line": "Massena holds Milan.", "intended": {"action": "hold", "marshal": "Massena", "target": "Milan", "note": "hold"}},
{"line": "hold ney", "intended": {"action": "hold", "marshal": "Ney", "target": "Rhineland", "note": "terse hold"}},
{"line": "Lannes is to hold Franche-Comte and let no one past.", "intended": {"action": "hold", "marshal": "Lannes", "target": "Franche-Comte", "note": "hold with intent"}},
{"line": "Murat — hold at Franche-Comte, no adventures.", "intended": {"action": "hold", "marshal": "Murat", "target": "Franche-Comte", "note": "hold with restraint"}},
{"line": "Keep Davout at Rhineland; hold.", "intended": {"action": "hold", "marshal": "Davout", "target": "Rhineland", "note": "keep = hold"}},
{"line": "Davout, defend Rhineland.", "intended": {"action": "defend", "marshal": "Davout", "target": "Rhineland", "note": "defend"}},
{"line": "Massena, defensive posture at Milan.", "intended": {"action": "defend", "marshal": "Massena", "target": "Milan", "note": "defensive posture"}},
{"line": "Soult will defend Lorraine against anything that comes out of Swabia.", "intended": {"action": "defend", "marshal": "Soult", "target": "Lorraine", "note": "defend with threat named"}},
{"line": "defend franconia bernadotte", "intended": {"action": "defend", "marshal": "Bernadotte", "target": "Franconia", "note": "lowercase, name last"}},
{"line": "Lannes, take up a defensive position.", "intended": {"action": "defend", "marshal": "Lannes", "target": "Franche-Comte", "note": "defend where he is"}},
{"line": "Ney is to stand on the defensive and receive Mack if he attacks.", "intended": {"action": "defend", "marshal": "Ney", "target": "Rhineland", "note": "period defend"}},
{"line": "Murat, defend Franche-Comte.", "intended": {"action": "defend", "marshal": "Murat", "target": "Franche-Comte", "note": "defend"}},
{"line": "Davout, dig in at Rhineland.", "intended": {"action": "fortify", "marshal": "Davout", "target": "Rhineland", "note": "dig in = fortify"}},
{"line": "Fortify Massena's position at Milan.", "intended": {"action": "fortify", "marshal": "Massena", "target": "Milan", "note": "fortify, possessive name"}},
{"line": "bernadotte fortify", "intended": {"action": "fortify", "marshal": "Bernadotte", "target": "Franconia", "note": "terse fortify"}},
{"line": "Ney, entrench — Mack may come at you.", "intended": {"action": "fortify", "marshal": "Ney", "target": "Rhineland", "note": "entrench with reason"}},
{"line": "Lannes will fortify Franche-Comte.", "intended": {"action": "fortify", "marshal": "Lannes", "target": "Franche-Comte", "note": "fortify"}},
{"line": "Soult: earthworks at Lorraine.", "intended": {"action": "fortify", "marshal": "Soult", "target": "Lorraine", "note": "earthworks = fortify"}},
{"line": "Have Murat's men dig in.", "intended": {"action": "fortify", "marshal": "Murat", "target": "Franche-Comte", "note": "dig in, cavalry"}},
{"line": "Massena, fortify Milan, the Archduke is close.", "intended": {"action": "fortify", "marshal": "Massena", "target": "Milan", "note": "fortify with reason"}},
{"line": "Davout, out of the trenches — unfortify.", "intended": {"action": "unfortify", "marshal": "Davout", "target": "Rhineland", "note": "unfortify"}},
{"line": "Massena may abandon his works at Milan.", "intended": {"action": "unfortify", "marshal": "Massena", "target": "Milan", "note": "abandon works = unfortify"}},
{"line": "Bernadotte, fall back from Franconia.", "intended": {"action": "retreat", "marshal": "Bernadotte", "target": "", "note": "fall back = retreat"}},
{"line": "Massena retreat to Piedmont.", "intended": {"action": "retreat", "marshal": "Massena", "target": "Piedmont", "note": "retreat with destination"}},
{"line": "retreat ney", "intended": {"action": "retreat", "marshal": "Ney", "target": "", "note": "terse retreat"}},
{"line": "Pull Lannes back to Lorraine.", "intended": {"action": "retreat", "marshal": "Lannes", "target": "Lorraine", "note": "retreat; a move would also be acceptable"}},
{"line": "Soult, withdraw.", "intended": {"action": "retreat", "marshal": "Soult", "target": "", "note": "withdraw = retreat"}},
{"line": "Davout is to retire and save the corps.", "intended": {"action": "retreat", "marshal": "Davout", "target": "", "note": "retire = retreat"}},
{"line": "Murat, pursue Mack.", "intended": {"action": "pursue", "marshal": "Murat", "target": "Mack", "note": "pursue"}},
{"line": "Ney, chase the Austrians down — pursue.", "intended": {"action": "pursue", "marshal": "Ney", "target": "Mack", "note": "chase = pursue; the Austrians in reach are Mack"}},
{"line": "pursue john with massena", "intended": {"action": "pursue", "marshal": "Massena", "target": "Archduke John", "note": "lowercase pursue"}},
{"line": "After the battle, Davout will pursue the beaten enemy.", "intended": {"action": "pursue", "marshal": "Davout", "target": "Mack", "note": "pursue, enemy implied"}},
{"line": "Soult, run Mack to ground.", "intended": {"action": "pursue", "marshal": "Soult", "target": "Mack", "note": "run to ground = pursue"}},
{"line": "Ney, support Soult.", "intended": {"action": "support", "marshal": "Ney", "target": "Soult", "note": "support"}},
{"line": "Davout will support Ney's attack.", "intended": {"action": "support", "marshal": "Davout", "target": "Ney", "note": "support"}},
{"line": "lannes support soult", "intended": {"action": "support", "marshal": "Lannes", "target": "Soult", "note": "terse support"}},
{"line": "Murat, cover Lannes.", "intended": {"action": "support", "marshal": "Murat", "target": "Lannes", "note": "cover = support"}},
{"line": "Bernadotte is to act in support of Massena.", "intended": {"action": "support", "marshal": "Bernadotte", "target": "Massena", "note": "formal support"}},
{"line": "Support Davout with Ney.", "intended": {"action": "support", "marshal": "Ney", "target": "Davout", "note": "supporter named last"}},
{"line": "Drill the men, Soult.", "intended": {"action": "drill", "marshal": "Soult", "target": "", "note": "drill, name last"}},
{"line": "Lannes, drill the corps while we wait.", "intended": {"action": "drill", "marshal": "Lannes", "target": "", "note": "drill"}},
{"line": "ney drill", "intended": {"action": "drill", "marshal": "Ney", "target": "", "note": "terse drill"}},
{"line": "Massena, put the Army of Italy through its drills.", "intended": {"action": "drill", "marshal": "Massena", "target": "", "note": "drill, noun form"}},
{"line": "Davout: training, two days.", "intended": {"action": "drill", "marshal": "Davout", "target": "", "note": "training = drill"}},
{"line": "Davout, form square.", "intended": {"action": "form_square", "marshal": "Davout", "target": "", "note": "square"}},
{"line": "Lannes — squares! The Austrian horse is coming.", "intended": {"action": "form_square", "marshal": "Lannes", "target": "", "note": "square with reason"}},
{"line": "soult form square", "intended": {"action": "form_square", "marshal": "Soult", "target": "", "note": "terse square"}},
{"line": "Buy substitutes to fill Bernadotte's corps.", "intended": {"action": "substitutes", "marshal": "Bernadotte", "target": "", "note": "substitutes"}},
{"line": "Fill Lannes up with substitutes, he's under strength.", "intended": {"action": "substitutes", "marshal": "Lannes", "target": "", "note": "substitutes with reason"}},
{"line": "substitutes for ney", "intended": {"action": "substitutes", "marshal": "Ney", "target": "", "note": "terse substitutes"}},
{"line": "Build a fort at Lorraine.", "intended": {"action": "build", "marshal": "state", "target": "Lorraine", "note": "fort"}},
{"line": "Berthier, a supply depot in Rhineland.", "intended": {"action": "build", "marshal": "state", "target": "Rhineland", "note": "depot, no verb"}},
{"line": "build stables in lyonnais", "intended": {"action": "build", "marshal": "state", "target": "Lyonnais", "note": "stables"}},
{"line": "Erect a depot at Franche-Comte for the army's supply.", "intended": {"action": "build", "marshal": "state", "target": "Franche-Comte", "note": "erect = build depot"}},
{"line": "Construct a fortress at Rhineland.", "intended": {"action": "build", "marshal": "state", "target": "Rhineland", "note": "construct = build fort"}},
{"line": "We need stables at Burgundy — build them.", "intended": {"action": "build", "marshal": "state", "target": "Burgundy", "note": "statement then build"}},
{"line": "Repair the fort at Lorraine.", "intended": {"action": "repair", "marshal": "state", "target": "Lorraine", "note": "repair"}},
{"line": "mend the walls at rhineland", "intended": {"action": "repair", "marshal": "state", "target": "Rhineland", "note": "mend = repair"}},
{"line": "Davout, leave a garrison in Rhineland.", "intended": {"action": "garrison", "marshal": "Davout", "target": "Rhineland", "note": "garrison"}},
{"line": "garrison lorraine with 2000 from soult", "intended": {"action": "garrison", "marshal": "Soult", "target": "Lorraine", "note": "garrison with number"}},
{"line": "Massena, detach a garrison for Milan before you march.", "intended": {"action": "garrison", "marshal": "Massena", "target": "Milan", "note": "detach = garrison"}},
{"line": "Leave 3,000 men behind at Franconia, Bernadotte.", "intended": {"action": "garrison", "marshal": "Bernadotte", "target": "Franconia", "note": "leave behind = garrison, name last"}},
{"line": "Invest 100 gold in Holland.", "intended": {"action": "invest", "marshal": "state", "target": "Holland", "note": "invest"}},
{"line": "Send 50 gold to the Kingdom of Italy's treasury.", "intended": {"action": "invest", "marshal": "state", "target": "Kingdom of Italy", "note": "send gold = invest"}},
{"line": "invest in switzerland", "intended": {"action": "invest", "marshal": "state", "target": "Switzerland", "note": "invest, no amount"}},
{"line": "Tighten the leash on Holland — reduce its autonomy.", "intended": {"action": "vassal", "marshal": "state", "target": "Holland", "note": "lower autonomy"}},
{"line": "Give the Kingdom of Italy more autonomy.", "intended": {"action": "vassal", "marshal": "state", "target": "Kingdom of Italy", "note": "raise autonomy"}},
{"line": "Reward Massena with an estate.", "intended": {"action": "reward", "marshal": "Massena", "target": "", "note": "estate"}},
{"line": "Make Soult a duke.", "intended": {"action": "reward", "marshal": "Soult", "target": "", "note": "title"}},
{"line": "give murat a title", "intended": {"action": "reward", "marshal": "Murat", "target": "", "note": "title, lowercase"}},
{"line": "Commission Suchet as a marshal.", "intended": {"action": "commission", "marshal": "state", "target": "Suchet", "note": "commission from the bench"}},
{"line": "Bring Oudinot off the bench.", "intended": {"action": "commission", "marshal": "state", "target": "Oudinot", "note": "colloquial commission"}},
{"line": "berthier appoint mortier", "intended": {"action": "commission", "marshal": "state", "target": "Mortier", "note": "appoint = commission"}},
{"line": "Enact the Staff.", "intended": {"action": "enact", "marshal": "state", "target": "the Staff", "note": "enact law"}},
{"line": "Pass the Artillery Reserve law.", "intended": {"action": "enact", "marshal": "state", "target": "the Artillery Reserve", "note": "pass = enact"}},
{"line": "Berthier, draft and enact the Staff reform.", "intended": {"action": "enact", "marshal": "state", "target": "the Staff", "note": "dictated enact"}},
{"line": "Repeal the Staff.", "intended": {"action": "repeal", "marshal": "state", "target": "the Staff", "note": "repeal"}},
{"line": "strike down the artillery reserve law", "intended": {"action": "repeal", "marshal": "state", "target": "the Artillery Reserve", "note": "strike down = repeal"}},
{"line": "Build ships at Brittany.", "intended": {"action": "naval_build", "marshal": "state", "target": "Brittany", "note": "build ships"}},
{"line": "the fleet needs more hulls - build two ships of the line", "intended": {"action": "naval_build", "marshal": "state", "target": "", "note": "ships, no port named"}},
{"line": "Set the fleet to blockade.", "intended": {"action": "naval_posture", "marshal": "state", "target": "", "note": "posture blockade"}},
{"line": "Keep the fleet in port — defensive posture.", "intended": {"action": "naval_posture", "marshal": "state", "target": "", "note": "posture defensive"}},
{"line": "Land troops in Ireland.", "intended": {"action": "naval_land", "marshal": "state", "target": "Ireland", "note": "expedition"}},
{"line": "A naval diversion off the English coast to draw the Royal Navy.", "intended": {"action": "naval_diversion", "marshal": "state", "target": "Britain", "note": "diversion"}},
{"line": "Declare war on Prussia.", "intended": {"action": "declare_war", "marshal": "state", "target": "Prussia", "note": "war declaration"}},
{"line": "talleyrand declare war on naples", "intended": {"action": "declare_war", "marshal": "state", "target": "Naples", "note": "lowercase war declaration"}},
{"line": "War with Sweden — declare it.", "intended": {"action": "declare_war", "marshal": "state", "target": "Sweden", "note": "inverted war declaration"}},
{"line": "Break the alliance with Spain.", "intended": {"action": "break_treaty", "marshal": "state", "target": "Spain", "note": "break a treaty"}},
{"line": "Cede Savoy to Sardinia — Talleyrand will arrange it.", "intended": {"action": "cede", "marshal": "state", "target": "Sardinia", "note": "cede Savoy"}},
{"line": "End turn.", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "end turn"}},
{"line": "that's all for today, next turn", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "colloquial end turn"}},
{"line": "Pass the turn, Berthier.", "intended": {"action": "end_turn", "marshal": "state", "target": "", "note": "pass = end turn"}},
{"line": "done", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "one-word end turn"}},
{"line": "Grouchy, march to Swabia.", "intended": {"action": "refuse", "marshal": "Grouchy", "target": "Swabia", "note": "no such marshal on the roster"}},
{"line": "Soult, attack Davout.", "intended": {"action": "refuse", "marshal": "Soult", "target": "Davout", "note": "attack on our own marshal"}},
{"line": "Declare war on Holland.", "intended": {"action": "refuse", "marshal": "state", "target": "Holland", "note": "war on our own satellite"}},
{"line": "Move Ney to Cairo.", "intended": {"action": "refuse", "marshal": "Ney", "target": "Cairo", "note": "province not on the map"}},
{"line": "Recruit 500,000 infantry in Paris.", "intended": {"action": "refuse", "marshal": "state", "target": "Paris", "note": "nonsense quantity"}},
{"line": "Talleyrand, attack Mack.", "intended": {"action": "refuse", "marshal": "state", "target": "Mack", "note": "wrong desk — the foreign minister cannot attack"}},
{"line": "Massena, hold Milan and march to Tyrol at the same time.", "intended": {"action": "refuse", "marshal": "Massena", "target": "Tyrol", "note": "contradictory order"}},
{"line": "Move Napoleon to Lorraine.", "intended": {"action": "refuse", "marshal": "Napoleon", "target": "Lorraine", "note": "already there"}},
{"line": "Wellington, attack Mack.", "intended": {"action": "refuse", "marshal": "Wellington", "target": "Mack", "note": "not one of our marshals"}},
{"line": "Berthier, propose peace to Austria.", "intended": {"action": "refuse", "marshal": "state", "target": "Austria", "note": "wrong desk — diplomacy belongs to Talleyrand"}},
{"line": "Attack the Bavarians at Munich, Lannes.", "intended": {"action": "refuse", "marshal": "Lannes", "target": "Munich", "note": "attack on an ally we are not at war with"}},
{"line": "Recruit cavalry in Swabia.", "intended": {"action": "refuse", "marshal": "state", "target": "Swabia", "note": "not our province"}},
{"line": "Build a fort in Vienna.", "intended": {"action": "refuse", "marshal": "state", "target": "Vienna", "note": "enemy soil, not ours to build on"}},
{"line": "Mack, retreat to Vienna.", "intended": {"action": "refuse", "marshal": "Mack", "target": "Vienna", "note": "orders to an enemy commander"}},
{"line": "Cede Swabia to Austria.", "intended": {"action": "refuse", "marshal": "state", "target": "Austria", "note": "we do not hold Swabia"}},
{"line": "Invest 5,000 gold in Holland.", "intended": {"action": "refuse", "marshal": "state", "target": "Holland", "note": "treasury holds 800"}},
{"line": "Massena, land troops in Tyrol.", "intended": {"action": "refuse", "marshal": "Massena", "target": "Tyrol", "note": "naval landing on a landlocked province"}},
{"line": "Soult, attack Napoleon.", "intended": {"action": "refuse", "marshal": "Soult", "target": "Napoleon", "note": "attack on the Emperor"}},
{"line": "Recruit -2000 infantry in Paris.", "intended": {"action": "refuse", "marshal": "state", "target": "Paris", "note": "negative quantity"}},
{"line": "Commission Wellington as a marshal.", "intended": {"action": "refuse", "marshal": "state", "target": "Wellington", "note": "not on the bench"}},
{"line": "Enact the Code of Hammurabi.", "intended": {"action": "refuse", "marshal": "state", "target": "Code of Hammurabi", "note": "no such law of state"}},
{"line": "Reward Mack with an estate.", "intended": {"action": "refuse", "marshal": "Mack", "target": "", "note": "an enemy commander"}},
{"line": "Davout, pursue Soult.", "intended": {"action": "refuse", "marshal": "Davout", "target": "Soult", "note": "pursue our own marshal"}},
{"line": "Lannes, support Mack.", "intended": {"action": "refuse", "marshal": "Lannes", "target": "Mack", "note": "support an enemy"}},
{"line": "Move Bernadotte to Franconia.", "intended": {"action": "refuse", "marshal": "Bernadotte", "target": "Franconia", "note": "already there"}},
{"line": "Massena, march to Corsica.", "intended": {"action": "refuse", "marshal": "Massena", "target": "Corsica", "note": "cannot walk to an island"}},
{"line": "Talleyrand, recruit infantry in Paris.", "intended": {"action": "refuse", "marshal": "state", "target": "Paris", "note": "wrong desk — the Cabinet does not raise troops"}},
{"line": "Give Holland independence and keep it as a vassal.", "intended": {"action": "refuse", "marshal": "state", "target": "Holland", "note": "contradictory"}},
{"line": "Garrison Swabia with 1,000 of Soult's men.", "intended": {"action": "refuse", "marshal": "Soult", "target": "Swabia", "note": "cannot garrison a province we do not hold"}},
{"line": "Invest gold in Prussia.", "intended": {"action": "refuse", "marshal": "state", "target": "Prussia", "note": "not a vassal"}}
]}
