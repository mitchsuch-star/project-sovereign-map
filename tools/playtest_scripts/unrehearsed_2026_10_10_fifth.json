{"line": "Ney, chase Mack wherever he runs.", "intended": {"action": "pursue", "marshal": "Ney", "target": "Mack", "note": "Ney pursues Mack"}},
{"line": "Davout: hound Mack, don't let him rest.", "intended": {"action": "pursue", "marshal": "Davout", "target": "Mack", "note": "Davout pursues Mack"}},
{"line": "Murat, after John — ride him down.", "intended": {"action": "pursue", "marshal": "Murat", "target": "Archduke John", "note": "Murat pursues John"}},
{"line": "Lannes pursues the Austrians.", "intended": {"action": "pursue", "marshal": "Lannes", "target": "Mack", "note": "Lannes pursues Mack"}},
{"line": "Soult, keep on Mack's heels.", "intended": {"action": "pursue", "marshal": "Soult", "target": "Mack", "note": "Soult pursues Mack"}},
{"line": "bernadotte pursue mack", "intended": {"action": "pursue", "marshal": "Bernadotte", "target": "Mack", "note": "Bernadotte pursues Mack"}},
{"line": "NEY ATTACK SWABIA", "intended": {"action": "attack", "marshal": "Ney", "target": "Swabia", "note": "Ney attacks Swabia"}},
{"line": "Swabia, Davout. Take it.", "intended": {"action": "attack", "marshal": "Davout", "target": "Swabia", "note": "Davout attacks Swabia"}},
{"line": "I want Mack gone by the end of the month. Soult and Lannes, converge on Swabia.", "intended": {"action": "attack", "marshal": "Soult", "target": "Swabia", "note": "Soult and Lannes attack Swabia"}},
{"line": "Massena, John sits at Tyrol — go and get him.", "intended": {"action": "attack", "marshal": "Massena", "target": "Tyrol", "note": "Massena attacks John"}},
{"line": "Murat to Swabia, charge.", "intended": {"action": "attack", "marshal": "Murat", "target": "Swabia", "note": "Murat charges Swabia"}},
{"line": "Ney, on to Swabia and the enemy.", "intended": {"action": "attack", "marshal": "Ney", "target": "Swabia", "note": "Ney attacks Swabia"}},
{"line": "Davout—attack—Mack—Swabia", "intended": {"action": "attack", "marshal": "Davout", "target": "Swabia", "note": "Davout attacks Mack in Swabia"}},
{"line": "lannes hit mack from the south", "intended": {"action": "attack", "marshal": "Lannes", "target": "Mack", "note": "Lannes attacks Mack"}},
{"line": "Napoleon leads the Guard against Mack.", "intended": {"action": "attack", "marshal": "Napoleon", "target": "Mack", "note": "Napoleon attacks Mack"}},
{"line": "Bernadotte, fall on Mack's flank at Swabia.", "intended": {"action": "attack", "marshal": "Bernadotte", "target": "Swabia", "note": "Bernadotte attacks Swabia"}},
{"line": "Ney: Gelderland.", "intended": {"action": "move", "marshal": "Ney", "target": "Gelderland", "note": "Ney moves to Gelderland"}},
{"line": "Soult, bring the corps up to Rhineland alongside Davout.", "intended": {"action": "move", "marshal": "Soult", "target": "Rhineland", "note": "Soult moves to Rhineland"}},
{"line": "Bernadotte goes to Frankfurt.", "intended": {"action": "move", "marshal": "Bernadotte", "target": "Frankfurt", "note": "Bernadotte moves to Frankfurt"}},
{"line": "Murat rides to Nivernais.", "intended": {"action": "move", "marshal": "Murat", "target": "Nivernais", "note": "Murat moves to Nivernais"}},
{"line": "The Emperor relocates to Paris.", "intended": {"action": "move", "marshal": "Napoleon", "target": "Paris", "note": "Napoleon moves to Paris"}},
{"line": "Massena, Piedmont, then wait there.", "intended": {"action": "move", "marshal": "Massena", "target": "Piedmont", "note": "Massena moves to Piedmont"}},
{"line": "lannes orleanais", "intended": {"action": "move", "marshal": "Lannes", "target": "Orleanais", "note": "Lannes moves to Orleanais"}},
{"line": "Davout marches on Munich to cut Mack from Vienna.", "intended": {"action": "move", "marshal": "Davout", "target": "Munich", "note": "Davout moves to Munich"}},
{"line": "Soult to Franche-Comte; Lannes to Lorraine. Swap.", "intended": {"action": "move", "marshal": "Soult", "target": "Franche-Comte", "note": "Soult to Franche-Comte, Lannes to Lorraine"}},
{"line": "Ney, make for Swabia but do not engage.", "intended": {"action": "move", "marshal": "Ney", "target": "Swabia", "note": "Ney moves toward Swabia without attacking"}},
{"line": "Hold, Ney.", "intended": {"action": "hold", "marshal": "Ney", "target": "Rhineland", "note": "Ney holds"}},
