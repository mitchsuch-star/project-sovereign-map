{"line": "sink some gold into switzerland", "intended": {"action": "invest", "marshal": "state", "target": "Switzerland", "note": "invest in Switzerland"}},
{"line": "Estate for Ney.", "intended": {"action": "reward", "marshal": "Ney", "target": "", "note": "estate for Ney"}},
