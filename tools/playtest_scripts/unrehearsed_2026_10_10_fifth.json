{"name": "unrehearsed-2026-10-10-fifth", "_note": "Written blind by a fifth author with no tool use — never edited after the run.", "orders": [
{"line": "Ney, hit Mack at Swabia.", "intended": {"action": "attack", "marshal": "Ney", "target": "Swabia", "note": "Ney attacks Mack in Swabia"}},
{"line": "davout go kill mack", "intended": {"action": "attack", "marshal": "Davout", "target": "Mack", "note": "Davout attacks Mack"}},
{"line": "Marshal Soult will march on Swabia and fall upon Mack's Austrians with everything he has.", "intended": {"action": "attack", "marshal": "Soult", "target": "Swabia", "note": "Soult attacks Mack in Swabia"}},
{"line": "Lannes - Mack - attack - now", "intended": {"action": "attack", "marshal": "Lannes", "target": "Mack", "note": "Lannes attacks Mack"}},
{"line": "Would you be so kind, Marshal Murat, as to charge the Austrians in Swabia.", "intended": {"action": "attack", "marshal": "Murat", "target": "Swabia", "note": "Murat attacks the Austrians in Swabia"}},
{"line": "Massena, strike Archduke John in the Tyrol before he gets wind of us.", "intended": {"action": "attack", "marshal": "Massena", "target": "Tyrol", "note": "Massena attacks John at Tyrol"}},
{"line": "Attack Mack with Ney and Davout together.", "intended": {"action": "attack", "marshal": "Ney", "target": "Mack", "note": "Ney and Davout attack Mack jointly"}},
{"line": "Bernadotte: assault Swabia from Franconia, catch Mack from the north", "intended": {"action": "attack", "marshal": "Bernadotte", "target": "Swabia", "note": "Bernadotte attacks Swabia"}},
{"line": "Mack must be destroyed. Davout, see to it.", "intended": {"action": "attack", "marshal": "Davout", "target": "Mack", "note": "Davout attacks Mack"}},
{"line": "The Guard goes in. Napoleon attacks Swabia.", "intended": {"action": "attack", "marshal": "Napoleon", "target": "Swabia", "note": "Napoleon attacks Swabia"}},
{"line": "ney smash the austrians in swabia, no mercy", "intended": {"action": "attack", "marshal": "Ney", "target": "Swabia", "note": "Ney attacks Swabia"}},
{"line": "Soult: engage Mack. Ney: engage Mack. Same day.", "intended": {"action": "attack", "marshal": "Soult", "target": "Mack", "note": "Soult and Ney both attack Mack"}},
{"line": "Murat, ride down John's corps at Tyrol.", "intended": {"action": "attack", "marshal": "Murat", "target": "Tyrol", "note": "Murat attacks John at Tyrol"}},
{"line": "Memo to Marshal Davout — the Emperor desires that you bring Mack to battle in Swabia at the earliest hour.", "intended": {"action": "attack", "marshal": "Davout", "target": "Swabia", "note": "Davout attacks Mack in Swabia"}},
{"line": "Davout attak Swabia", "intended": {"action": "attack", "marshal": "Davout", "target": "Swabia", "note": "Davout attacks Swabia (typo)"}},
{"line": "Lannes, get yourself to Swabia.", "intended": {"action": "move", "marshal": "Lannes", "target": "Swabia", "note": "Lannes marches to Swabia"}},
{"line": "Move Ney to Frankfurt.", "intended": {"action": "move", "marshal": "Ney", "target": "Frankfurt", "note": "Ney marches to Frankfurt"}},
{"line": "Soult marches for the Rhineland.", "intended": {"action": "move", "marshal": "Soult", "target": "Rhineland", "note": "Soult moves to Rhineland"}},
{"line": "murat to munich", "intended": {"action": "move", "marshal": "Murat", "target": "Munich", "note": "Murat moves to Munich"}},
{"line": "Bernadotte, shift your corps to Bohemia, and keep an eye out for Charles on the way.", "intended": {"action": "move", "marshal": "Bernadotte", "target": "Bohemia", "note": "Bernadotte moves to Bohemia"}},
{"line": "Massena is to cross into Piedmont.", "intended": {"action": "move", "marshal": "Massena", "target": "Piedmont", "note": "Massena moves to Piedmont"}},
{"line": "To Lorraine, Marshal Lannes, and quickly.", "intended": {"action": "move", "marshal": "Lannes", "target": "Lorraine", "note": "Lannes moves to Lorraine"}},
{"line": "Napoleon moves the Guard to Rhineland.", "intended": {"action": "move", "marshal": "Napoleon", "target": "Rhineland", "note": "Napoleon moves to Rhineland"}},
{"line": "Davout and Ney both march to Frankfurt.", "intended": {"action": "move", "marshal": "Davout", "target": "Frankfurt", "note": "Davout and Ney move to Frankfurt"}},
{"line": "Marshal Ney, kindly take your corps down to Nassau.", "intended": {"action": "move", "marshal": "Ney", "target": "Nassau", "note": "Ney moves to Nassau"}},
{"line": "Lannes → Bern", "intended": {"action": "move", "marshal": "Lannes", "target": "Bern", "note": "Lannes moves to Bern"}},
{"line": "soult, pls go to franche-comte", "intended": {"action": "move", "marshal": "Soult", "target": "Franche-Comte", "note": "Soult moves to Franche-Comte"}},
{"line": "Shift Murat's horse to Lorraine so he can screen the Emperor.", "intended": {"action": "move", "marshal": "Murat", "target": "Lorraine", "note": "Murat moves to Lorraine"}},
{"line": "Bernadotte — Dresden — go.", "intended": {"action": "move", "marshal": "Bernadotte", "target": "Dresden", "note": "Bernadotte moves to Dresden"}},
{"line": "Davout, I want you in Brabant covering the Dutch coast.", "intended": {"action": "move", "marshal": "Davout", "target": "Brabant", "note": "Davout moves to Brabant"}},
{"line": "Ney holds Rhineland.", "intended": {"action": "hold", "marshal": "Ney", "target": "Rhineland", "note": "Ney holds position"}},
{"line": "Davout, stay put.", "intended": {"action": "hold", "marshal": "Davout", "target": "Rhineland", "note": "Davout holds in place"}},
{"line": "Massena, hold Milan whatever happens.", "intended": {"action": "hold", "marshal": "Massena", "target": "Milan", "note": "Massena holds Milan"}},
{"line": "Marshal Soult, hold your position until further orders.", "intended": {"action": "hold", "marshal": "Soult", "target": "Lorraine", "note": "Soult holds Lorraine"}},
{"line": "lannes dont move", "intended": {"action": "hold", "marshal": "Lannes", "target": "Franche-Comte", "note": "Lannes holds in place"}},
{"line": "Bernadotte will remain at Franconia and not budge.", "intended": {"action": "hold", "marshal": "Bernadotte", "target": "Franconia", "note": "Bernadotte holds Franconia"}},
{"line": "Murat, hold where you are, I'll need you later.", "intended": {"action": "hold", "marshal": "Murat", "target": "Franche-Comte", "note": "Murat holds in place"}},
{"line": "Davout, dig in and defend Rhineland against anything coming out of Swabia.", "intended": {"action": "defend", "marshal": "Davout", "target": "Rhineland", "note": "Davout defends Rhineland"}},
{"line": "Soult defends Lorraine.", "intended": {"action": "defend", "marshal": "Soult", "target": "Lorraine", "note": "Soult takes defensive stance"}},
{"line": "Massena — defensive posture at Milan, John may come down from the mountains.", "intended": {"action": "defend", "marshal": "Massena", "target": "Milan", "note": "Massena defends Milan"}},
{"line": "Ney, defensive stance please.", "intended": {"action": "defend", "marshal": "Ney", "target": "Rhineland", "note": "Ney goes defensive"}},
{"line": "lannes defend franche-comte", "intended": {"action": "defend", "marshal": "Lannes", "target": "Franche-Comte", "note": "Lannes defends Franche-Comte"}},
{"line": "Have Bernadotte stand on the defensive at Franconia.", "intended": {"action": "defend", "marshal": "Bernadotte", "target": "Franconia", "note": "Bernadotte defends Franconia"}},
{"line": "Murat, scout Swabia.", "intended": {"action": "scout", "marshal": "Murat", "target": "Swabia", "note": "Murat scouts Swabia"}},
{"line": "Send riders toward Munich, Murat, I want to know what's there.", "intended": {"action": "scout", "marshal": "Murat", "target": "Munich", "note": "Murat scouts Munich"}},
{"line": "Ney, reconnoitre Frankfurt.", "intended": {"action": "scout", "marshal": "Ney", "target": "Frankfurt", "note": "Ney scouts Frankfurt"}},
{"line": "massena scout tyrol", "intended": {"action": "scout", "marshal": "Massena", "target": "Tyrol", "note": "Massena scouts Tyrol"}},
{"line": "Bernadotte: patrols into Bohemia, find me Charles.", "intended": {"action": "scout", "marshal": "Bernadotte", "target": "Bohemia", "note": "Bernadotte scouts Bohemia"}},
{"line": "Lannes, probe toward Bern and report.", "intended": {"action": "scout", "marshal": "Lannes", "target": "Bern", "note": "Lannes scouts Bern"}},
{"line": "Davout, a reconnaissance of Nassau if you please.", "intended": {"action": "scout", "marshal": "Davout", "target": "Nassau", "note": "Davout scouts Nassau"}},
{"line": "Murat is to scout Dresden — where is Kutuzov?", "intended": {"action": "scout", "marshal": "Murat", "target": "Dresden", "note": "Murat scouts Dresden"}},
{"line": "Ney, fortify Rhineland.", "intended": {"action": "fortify", "marshal": "Ney", "target": "Rhineland", "note": "Ney fortifies"}},
{"line": "Massena digs in at Milan.", "intended": {"action": "fortify", "marshal": "Massena", "target": "Milan", "note": "Massena fortifies Milan"}},
{"line": "soult fortify", "intended": {"action": "fortify", "marshal": "Soult", "target": "Lorraine", "note": "Soult fortifies in place"}},
{"line": "Davout, throw up earthworks on the Rhine.", "intended": {"action": "fortify", "marshal": "Davout", "target": "Rhineland", "note": "Davout fortifies Rhineland"}},
{"line": "Entrench at Franconia, Bernadotte.", "intended": {"action": "fortify", "marshal": "Bernadotte", "target": "Franconia", "note": "Bernadotte fortifies"}},
{"line": "Lannes — fortify Franche-Comte, we may be there a while.", "intended": {"action": "fortify", "marshal": "Lannes", "target": "Franche-Comte", "note": "Lannes fortifies"}},
{"line": "Ney, strike camp, abandon the works.", "intended": {"action": "unfortify", "marshal": "Ney", "target": "Rhineland", "note": "Ney unfortifies"}},
{"line": "Massena, leave the entrenchments, we're moving.", "intended": {"action": "unfortify", "marshal": "Massena", "target": "Milan", "note": "Massena unfortifies"}},
{"line": "soult unfortify lorraine", "intended": {"action": "unfortify", "marshal": "Soult", "target": "Lorraine", "note": "Soult unfortifies"}},
{"line": "Davout, drill the men.", "intended": {"action": "drill", "marshal": "Davout", "target": "Rhineland", "note": "Davout drills"}},
{"line": "Ney — drilling this turn.", "intended": {"action": "drill", "marshal": "Ney", "target": "Rhineland", "note": "Ney drills"}},
{"line": "Marshal Lannes, exercise the corps; the recruits are green.", "intended": {"action": "drill", "marshal": "Lannes", "target": "Franche-Comte", "note": "Lannes drills"}},
{"line": "massena drill ur troops", "intended": {"action": "drill", "marshal": "Massena", "target": "Milan", "note": "Massena drills"}},
{"line": "Have Bernadotte put his corps through its paces.", "intended": {"action": "drill", "marshal": "Bernadotte", "target": "Franconia", "note": "Bernadotte drills"}},
{"line": "Murat, train the cavalry.", "intended": {"action": "drill", "marshal": "Murat", "target": "Franche-Comte", "note": "Murat drills"}},
{"line": "Soult, a week of drill.", "intended": {"action": "drill", "marshal": "Soult", "target": "Lorraine", "note": "Soult drills"}},
{"line": "The Guard drills at Lorraine.", "intended": {"action": "drill", "marshal": "Napoleon", "target": "Lorraine", "note": "Napoleon drills the Guard"}},
{"line": "Ney and Davout both drill at Rhineland.", "intended": {"action": "drill", "marshal": "Ney", "target": "Rhineland", "note": "Ney and Davout drill"}},
{"line": "Lannes, musketry practice.", "intended": {"action": "drill", "marshal": "Lannes", "target": "Franche-Comte", "note": "Lannes drills"}},
{"line": "Ney, fall back to Lorraine.", "intended": {"action": "retreat", "marshal": "Ney", "target": "Lorraine", "note": "Ney retreats to Lorraine"}},
{"line": "Massena, pull back from Milan.", "intended": {"action": "retreat", "marshal": "Massena", "target": "", "note": "Massena retreats from Milan"}},
{"line": "davout retreat", "intended": {"action": "retreat", "marshal": "Davout", "target": "", "note": "Davout retreats"}},
{"line": "Bernadotte, pull back to the Rhineland.", "intended": {"action": "retreat", "marshal": "Bernadotte", "target": "Rhineland", "note": "Bernadotte retreats to Rhineland"}},
{"line": "Lannes, get out of there — fall back on Lorraine.", "intended": {"action": "retreat", "marshal": "Lannes", "target": "Lorraine", "note": "Lannes retreats to Lorraine"}},
{"line": "Soult, retire on Franche-Comte.", "intended": {"action": "retreat", "marshal": "Soult", "target": "Franche-Comte", "note": "Soult retreats to Franche-Comte"}},
{"line": "Murat, disengage and withdraw.", "intended": {"action": "retreat", "marshal": "Murat", "target": "", "note": "Murat retreats"}},
{"line": "Pull Ney back behind the Rhine.", "intended": {"action": "retreat", "marshal": "Ney", "target": "", "note": "Ney retreats westward"}},
{"line": "Massena retreats to Savoy.", "intended": {"action": "retreat", "marshal": "Massena", "target": "Savoy", "note": "Massena retreats to Savoy"}},
{"line": "Lannes, break off, rejoin Soult at Lorraine.", "intended": {"action": "retreat", "marshal": "Lannes", "target": "Lorraine", "note": "Lannes retreats to Lorraine"}},
{"line": "Recruit infantry in Paris.", "intended": {"action": "recruit", "marshal": "state", "target": "Paris", "note": "recruit infantry at Paris"}},
{"line": "raise 5000 infantry at lyonnais", "intended": {"action": "recruit", "marshal": "state", "target": "Lyonnais", "note": "recruit infantry at Lyonnais"}},
{"line": "Recruit cavalry for Murat.", "intended": {"action": "recruit", "marshal": "Murat", "target": "", "note": "recruit cavalry for Murat"}},
{"line": "We need guns. Recruit artillery in Ile-de-France.", "intended": {"action": "recruit", "marshal": "state", "target": "Ile-de-France", "note": "recruit artillery"}},
{"line": "Recruit in Burgundy — infantry, as many as we can afford.", "intended": {"action": "recruit", "marshal": "state", "target": "Burgundy", "note": "recruit infantry at Burgundy"}},
{"line": "Ney, recruit infantry at Rhineland to fill out your corps.", "intended": {"action": "recruit", "marshal": "Ney", "target": "Rhineland", "note": "recruit infantry for Ney"}},
{"line": "Raise a regiment of horse in Champagne.", "intended": {"action": "recruit", "marshal": "state", "target": "Champagne", "note": "recruit cavalry at Champagne"}},
{"line": "recruit artillery normandy", "intended": {"action": "recruit", "marshal": "state", "target": "Normandy", "note": "recruit artillery at Normandy"}},
{"line": "Massena needs men — recruit infantry at Milan.", "intended": {"action": "recruit", "marshal": "Massena", "target": "Milan", "note": "recruit infantry at Milan"}},
{"line": "Please recruit some cavalry in Picardy when you get a chance.", "intended": {"action": "recruit", "marshal": "state", "target": "Picardy", "note": "recruit cavalry at Picardy"}},
{"line": "Buy substitutes to top up Lannes.", "intended": {"action": "substitutes", "marshal": "Lannes", "target": "", "note": "substitutes for Lannes"}},
{"line": "substitutes for ney", "intended": {"action": "substitutes", "marshal": "Ney", "target": "", "note": "substitutes for Ney"}},
{"line": "Pay for substitutes in Paris, the levy is thin.", "intended": {"action": "substitutes", "marshal": "state", "target": "Paris", "note": "buy substitutes"}},
{"line": "Build a depot at Lorraine.", "intended": {"action": "build", "marshal": "state", "target": "Lorraine", "note": "build depot"}},
{"line": "Build a fort in Rhineland.", "intended": {"action": "build", "marshal": "state", "target": "Rhineland", "note": "build fort"}},
{"line": "a training ground in paris pls", "intended": {"action": "build", "marshal": "state", "target": "Paris", "note": "build training ground"}},
{"line": "Construct a depot at Franche-Comte so the march east is supplied.", "intended": {"action": "build", "marshal": "state", "target": "Franche-Comte", "note": "build depot"}},
{"line": "Fort at Milan, Massena will need it.", "intended": {"action": "build", "marshal": "state", "target": "Milan", "note": "build fort at Milan"}},
{"line": "build depot burgundy", "intended": {"action": "build", "marshal": "state", "target": "Burgundy", "note": "build depot"}},
{"line": "Put a training ground up in Lyonnais.", "intended": {"action": "build", "marshal": "state", "target": "Lyonnais", "note": "build training ground"}},
{"line": "Build fortifications at Flanders against a British landing.", "intended": {"action": "build", "marshal": "state", "target": "Flanders", "note": "build fort at Flanders"}},
{"line": "Repair the fort at Paris.", "intended": {"action": "repair", "marshal": "state", "target": "Paris", "note": "repair Paris fort"}},
{"line": "repair lorraine", "intended": {"action": "repair", "marshal": "state", "target": "Lorraine", "note": "repair at Lorraine"}},
{"line": "Have the works at Rhineland repaired.", "intended": {"action": "repair", "marshal": "state", "target": "Rhineland", "note": "repair Rhineland"}},
{"line": "Garrison Paris.", "intended": {"action": "garrison", "marshal": "state", "target": "Paris", "note": "garrison Paris"}},
{"line": "Ney, leave a garrison in Rhineland.", "intended": {"action": "garrison", "marshal": "Ney", "target": "Rhineland", "note": "Ney detaches a garrison"}},
{"line": "garrison milan with 3000", "intended": {"action": "garrison", "marshal": "Massena", "target": "Milan", "note": "garrison Milan"}},
{"line": "Davout, detach a garrison for Frankfurt once you hold it.", "intended": {"action": "garrison", "marshal": "Davout", "target": "Frankfurt", "note": "Davout garrisons Frankfurt"}},
{"line": "Soult, drop off a garrison in Lorraine before you march.", "intended": {"action": "garrison", "marshal": "Soult", "target": "Lorraine", "note": "Soult garrisons Lorraine"}},
{"line": "Garrison Flanders, the coast worries me.", "intended": {"action": "garrison", "marshal": "state", "target": "Flanders", "note": "garrison Flanders"}},
{"line": "Invest 100 gold in Holland.", "intended": {"action": "invest", "marshal": "state", "target": "Holland", "note": "invest in Holland"}},
{"line": "invest in the kingdom of italy", "intended": {"action": "invest", "marshal": "state", "target": "Kingdom of Italy", "note": "invest in Italy"}},
{"line": "Put 50 gold into Switzerland.", "intended": {"action": "invest", "marshal": "state", "target": "Switzerland", "note": "invest in Switzerland"}},
{"line": "Reward Davout with an estate.", "intended": {"action": "reward", "marshal": "Davout", "target": "", "note": "estate for Davout"}},
{"line": "Give Ney a title.", "intended": {"action": "reward", "marshal": "Ney", "target": "", "note": "title for Ney"}},
{"line": "massena gets a rente", "intended": {"action": "reward", "marshal": "Massena", "target": "", "note": "rente for Massena"}},
{"line": "Lannes has earned a title — grant it.", "intended": {"action": "reward", "marshal": "Lannes", "target": "", "note": "title for Lannes"}},
{"line": "An estate for Marshal Soult, with the Emperor's thanks.", "intended": {"action": "reward", "marshal": "Soult", "target": "", "note": "estate for Soult"}},
{"line": "Reward Murat — a rente of state.", "intended": {"action": "reward", "marshal": "Murat", "target": "", "note": "rente for Murat"}},
{"line": "Bernadotte, an estate, grudgingly.", "intended": {"action": "reward", "marshal": "Bernadotte", "target": "", "note": "estate for Bernadotte"}},
{"line": "Enact the Staff.", "intended": {"action": "enact", "marshal": "state", "target": "the Staff", "note": "enact the Staff law"}},
{"line": "enact artillery reserve", "intended": {"action": "enact", "marshal": "state", "target": "the Artillery Reserve", "note": "enact the Artillery Reserve"}},
{"line": "Pass the law of the Staff, Berthier, and tell me the upkeep.", "intended": {"action": "enact", "marshal": "state", "target": "the Staff", "note": "enact the Staff"}},
{"line": "Repeal the Artillery Reserve.", "intended": {"action": "repeal", "marshal": "state", "target": "the Artillery Reserve", "note": "repeal the Artillery Reserve"}},
{"line": "repeal the staff", "intended": {"action": "repeal", "marshal": "state", "target": "the Staff", "note": "repeal the Staff"}},
{"line": "Strike the Artillery Reserve from the laws, it costs too much.", "intended": {"action": "repeal", "marshal": "state", "target": "the Artillery Reserve", "note": "repeal the Artillery Reserve"}},
{"line": "Commission Oudinot.", "intended": {"action": "commission", "marshal": "state", "target": "Oudinot", "note": "commission Oudinot"}},
{"line": "Make Suchet a marshal.", "intended": {"action": "commission", "marshal": "state", "target": "Suchet", "note": "commission Suchet"}},
{"line": "commission mortier from the bench", "intended": {"action": "commission", "marshal": "state", "target": "Mortier", "note": "commission Mortier"}},
{"line": "The Emperor raises Oudinot to the marshalate.", "intended": {"action": "commission", "marshal": "state", "target": "Oudinot", "note": "commission Oudinot"}},
{"line": "Build ships at Brittany.", "intended": {"action": "naval_build", "marshal": "state", "target": "Brittany", "note": "build ships at Brittany"}},
{"line": "build a fleet", "intended": {"action": "naval_build", "marshal": "state", "target": "", "note": "build ships"}},
{"line": "Lay down ships at Provence for the Mediterranean.", "intended": {"action": "naval_build", "marshal": "state", "target": "Provence", "note": "build ships at Provence"}},
{"line": "Fleet: guard home waters.", "intended": {"action": "naval_posture", "marshal": "state", "target": "", "note": "fleet guards home waters"}},
{"line": "Blockade Britain.", "intended": {"action": "naval_posture", "marshal": "state", "target": "Britain", "note": "fleet to blockade"}},
{"line": "set the fleet to blockade", "intended": {"action": "naval_posture", "marshal": "state", "target": "", "note": "blockade posture"}},
{"line": "Keep the fleet at anchor guarding the Channel ports.", "intended": {"action": "naval_posture", "marshal": "state", "target": "", "note": "guard home waters"}},
{"line": "Land an expedition in Ireland.", "intended": {"action": "naval_land", "marshal": "state", "target": "Ireland", "note": "naval expedition to Ireland"}},
{"line": "naval expedition to britain", "intended": {"action": "naval_land", "marshal": "state", "target": "Britain", "note": "naval landing in Britain"}},
{"line": "Put 10,000 men on ships and land them on the English coast.", "intended": {"action": "naval_land", "marshal": "state", "target": "Britain", "note": "naval landing in Britain"}},
{"line": "Naval diversion — draw the Royal Navy off.", "intended": {"action": "naval_diversion", "marshal": "state", "target": "Britain", "note": "naval diversion"}},
{"line": "run a diversion with the fleet toward the west indies", "intended": {"action": "naval_diversion", "marshal": "state", "target": "", "note": "naval diversion"}},
{"line": "Talleyrand, propose peace to Austria.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Austria", "note": "peace proposal to Austria"}},
{"line": "offer russia a truce", "intended": {"action": "diplomacy", "marshal": "state", "target": "Russia", "note": "truce proposal to Russia"}},
{"line": "Talleyrand, send a mission to Prussia.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Prussia", "note": "diplomatic mission to Prussia"}},
{"line": "Propose an alliance with Bavaria.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Bavaria", "note": "alliance proposal to Bavaria"}},
{"line": "talleyrand sound out spain about an alliance", "intended": {"action": "diplomacy", "marshal": "state", "target": "Spain", "note": "alliance proposal to Spain"}},
{"line": "Open negotiations with Britain, Talleyrand, see what they want.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Britain", "note": "open talks with Britain"}},
{"line": "Send an envoy to Saxony.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Saxony", "note": "mission to Saxony"}},
{"line": "Propose a trade agreement to Denmark.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Denmark", "note": "trade proposal to Denmark"}},
{"line": "Talleyrand: non-aggression pact with Prussia, whatever it costs.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Prussia", "note": "non-aggression pact with Prussia"}},
{"line": "Ask Naples for a treaty of friendship.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Naples", "note": "friendship treaty with Naples"}},
{"line": "Mission to the Porte — Talleyrand, court the Ottomans.", "intended": {"action": "diplomacy", "marshal": "state", "target": "Ottoman", "note": "mission to the Ottomans"}},
{"line": "propose peace austria", "intended": {"action": "diplomacy", "marshal": "state", "target": "Austria", "note": "peace proposal to Austria"}},
{"line": "Declare war on Prussia.", "intended": {"action": "declare_war", "marshal": "state", "target": "Prussia", "note": "war on Prussia"}},
{"line": "war on naples", "intended": {"action": "declare_war", "marshal": "state", "target": "Naples", "note": "war on Naples"}},
{"line": "Talleyrand, we declare war on Sweden.", "intended": {"action": "declare_war", "marshal": "state", "target": "Sweden", "note": "war on Sweden"}},
{"line": "Break the treaty with Spain.", "intended": {"action": "break_treaty", "marshal": "state", "target": "Spain", "note": "break treaty with Spain"}},
{"line": "tear up the agreement with prussia", "intended": {"action": "break_treaty", "marshal": "state", "target": "Prussia", "note": "break treaty with Prussia"}},
{"line": "Repudiate our treaty with Denmark.", "intended": {"action": "break_treaty", "marshal": "state", "target": "Denmark", "note": "break treaty with Denmark"}},
{"line": "Tighten the leash on Holland — lower their autonomy.", "intended": {"action": "vassal", "marshal": "state", "target": "Holland", "note": "lower Holland autonomy"}},
{"line": "Give Switzerland more autonomy.", "intended": {"action": "vassal", "marshal": "state", "target": "Switzerland", "note": "raise Switzerland autonomy"}},
{"line": "make bavaria a vassal", "intended": {"action": "vassal", "marshal": "state", "target": "Bavaria", "note": "make Bavaria a vassal"}},
{"line": "Release the Kingdom of Italy from vassalage.", "intended": {"action": "vassal", "marshal": "state", "target": "Kingdom of Italy", "note": "release vassal Italy"}},
{"line": "Cede Savoy to Sardinia.", "intended": {"action": "cede", "marshal": "state", "target": "Sardinia", "note": "cede Savoy to Sardinia"}},
{"line": "cede corsica to britain for peace", "intended": {"action": "cede", "marshal": "state", "target": "Britain", "note": "cede Corsica to Britain"}},
{"line": "Hand Flanders over to Holland.", "intended": {"action": "cede", "marshal": "state", "target": "Holland", "note": "cede Flanders to Holland"}},
{"line": "Ney, form square.", "intended": {"action": "form_square", "marshal": "Ney", "target": "", "note": "Ney forms square"}},
{"line": "davout square up, cavalry about", "intended": {"action": "form_square", "marshal": "Davout", "target": "", "note": "Davout forms square"}},
{"line": "Lannes forms square against the Austrian horse.", "intended": {"action": "form_square", "marshal": "Lannes", "target": "", "note": "Lannes forms square"}},
{"line": "Squares, Massena.", "intended": {"action": "form_square", "marshal": "Massena", "target": "", "note": "Massena forms square"}},
{"line": "End turn.", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "end the turn"}},
{"line": "next turn", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "end the turn"}},
{"line": "That is all for today, Berthier. Close the turn.", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "end the turn"}},
{"line": "Done. Advance the clock.", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "end the turn"}},
{"line": "pass", "intended": {"action": "end_turn", "marshal": "", "target": "", "note": "end the turn"}},
{"line": "Lannes supports Soult.", "intended": {"action": "support", "marshal": "Lannes", "target": "Soult", "note": "Lannes supports Soult"}},
{"line": "Davout, support Ney's attack.", "intended": {"action": "support", "marshal": "Davout", "target": "Ney", "note": "Davout supports Ney"}},
{"line": "murat support lannes", "intended": {"action": "support", "marshal": "Murat", "target": "Lannes", "note": "Murat supports Lannes"}},
