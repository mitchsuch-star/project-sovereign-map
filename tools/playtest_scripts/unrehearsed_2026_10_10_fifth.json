{"line": "Massena, support Lannes if he's engaged.", "intended": {"action": "support", "marshal": "Massena", "target": "Lannes", "note": "Massena supports Lannes"}},
{"line": "Murat, pursue Mack.", "intended": {"action": "pursue", "marshal": "Murat", "target": "Mack", "note": "Murat pursues Mack"}},
