{"line": "Davout stands fast at Rhineland.", "intended": {"action": "hold", "marshal": "Davout", "target": "Rhineland", "note": "Davout holds"}},
{"line": "Soult, defend the Lorraine crossings.", "intended": {"action": "defend", "marshal": "Soult", "target": "Lorraine", "note": "Soult defends Lorraine"}},
{"line": "Murat — defensive — Franche-Comte.", "intended": {"action": "defend", "marshal": "Murat", "target": "Franche-Comte", "note": "Murat defends"}},
{"line": "Scout Swabia with Ney.", "intended": {"action": "scout", "marshal": "Ney", "target": "Swabia", "note": "Ney scouts Swabia"}},
